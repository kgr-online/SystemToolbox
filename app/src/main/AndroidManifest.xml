<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by PlayStoreTagger to enumerate all installed packages, and
         by Toolbelt's app picker / Slim List's task labels. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Toolbelt haptics. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SystemToolbox"
        android:supportsRtl="true">

        <!-- Required for LSPosed to recognize this app as an Xposed module at
             all - without these, the module can appear transiently in
             LSPosed's scanner but won't persist in its module list across a
             rescan/reboot. api:82 matches the compileOnly dependency in
             build.gradle.kts. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="SystemToolbox: hides the nav bar / bottom swipe gesture in Pixel Launcher when the Toolbelt is active" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SystemToolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Backs Toolbelt (the bottom bar overlay) and Slim List Recents
             (the standalone task-list overlay). -->
        <service
            android:name=".service.SystemAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
